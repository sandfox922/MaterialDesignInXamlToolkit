<UserControl x:Class="MaterialDesignDemo.Shared.Examples.NumericUpDown.UpdateSourceModeExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaterialDesignDemo.Shared.Examples.NumericUpDown"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="450"
             d:DesignWidth="800" x:Name="root"
             mc:Ignorable="d">
  <materialDesign:Card Padding="16">
    <StackPanel>
      <TextBlock Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                 Text="Test" />

      <TextBlock Margin="0,0,0,16"
                 Text="SelectAllOnFocus / DecimalPlaces"
                 TextWrapping="Wrap" />

      <WrapPanel Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="Decimal-LostFocus" />
          <TextBlock Text="{Binding ValueLostFocus, ElementName=root, StringFormat={}Value\={0}}" />
          <smtx:XamlDisplay UniqueKey="NumericUpDown_UpdateSourceModeExample_1">

            <materialDesign:DecimalUpDown Value="{Binding ValueLostFocus, ElementName=root, UpdateSourceTrigger=LostFocus}"
                                          SelectAllOnFocus="True" DecimalPlaces="2" Width="140" ValueStep="0.5" Minimum="2" Maximum="20"  />
          </smtx:XamlDisplay>
        </StackPanel>

        <StackPanel Margin="8">
          <TextBlock Text="Double-PropertyChanged" />
          <TextBlock Text="{Binding ValuePropertyChanged, ElementName=root, StringFormat={}Value\={0}}" />
          <smtx:XamlDisplay UniqueKey="NumericUpDown_UpdateSourceModeExample_2">

            <materialDesign:DoubleUpDown Value="{Binding ValuePropertyChanged, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                                         SelectAllOnFocus="True" DecimalPlaces="3" Width="140" ValueStep="1" Minimum="2" Maximum="20" />
          </smtx:XamlDisplay>
        </StackPanel>

        <StackPanel Margin="8">
          <TextBlock Text="NumericUpDown" />
          <smtx:XamlDisplay UniqueKey="NumericUpDown_UpdateSourceModeExample_3">

            <materialDesign:NumericUpDown Width="120" DecimalPlaces="2" SelectAllOnFocus="True" Value="3" />
          </smtx:XamlDisplay>
        </StackPanel>

        <StackPanel Margin="8">
          <TextBlock Text="IsEditable=False" />
          <smtx:XamlDisplay UniqueKey="NumericUpDown_UpdateSourceModeExample_4">

            <materialDesign:NumericUpDown Width="120" IsEditable="False" Value="14" />
          </smtx:XamlDisplay>
        </StackPanel>
      </WrapPanel>
    </StackPanel>
  </materialDesign:Card>
</UserControl>
